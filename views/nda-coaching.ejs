<!-- ── Why Garud Classes for NDA? ── -->
<section style="padding:64px 0;background:#f8f9fa;">
  <div class="container">
    <div style="text-align:center;margin-bottom:44px;">
      <h2 style="font-size:clamp(1.5rem,3vw,2.1rem);font-weight:800;color:#1d3557;">
        Why Choose Garud Classes for <span style="color:#e63946;">NDA Coaching?</span>
      </h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;">
      <% [
        { icon:'fas fa-book', color:'#e63946', title:'Comprehensive Syllabus Coverage', desc:'Complete coverage of Mathematics and GAT as per the latest UPSC NDA syllabus.' },
        { icon:'fas fa-dumbbell', color:'#1d3557', title:'Physical & SSB Guidance', desc:'Mentorship on SSB interview preparation and physical fitness standards required for the Armed Forces.' },
        { icon:'fas fa-clipboard-list', color:'#2a9d8f', title:'Regular Mock Tests', desc:'Weekly mock tests simulating the actual NDA exam environment to boost speed and accuracy.' },
        { icon:'fas fa-chalkboard-teacher', color:'#f4a261', title:'Expert Faculty', desc:'Learn from highly experienced faculty who specialize in defense exam preparation.' }
      ].forEach(item => { %>
      <div style="background:#fff;border-radius:14px;padding:28px;box-shadow:0 4px 20px rgba(0,0,0,.07);transition:transform .2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
        <div style="width:52px;height:52px;border-radius:12px;background:<%= item.color %>18;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
          <i class="<%= item.icon %>" style="font-size:1.4rem;color:<%= item.color %>;"></i>
        </div>
        <h3 style="font-size:1rem;font-weight:700;color:#1d3557;margin-bottom:8px;"><%= item.title %></h3>
        <p style="color:#718096;font-size:.88rem;line-height:1.6;margin:0;"><%= item.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

